@model List<StudentAdminPortal.Models.Procedure>
@{
    ViewData["Title"] = "Trang chủ - Cổng Một Cửa Điện Tử Sinh Viên";
}

<!-- Hero Section -->
<div class="relative overflow-hidden bg-gradient-to-b from-brand-900 via-brand-800 to-slate-900 text-white pt-16 pb-24">
    <!-- Decorative background glow -->
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-brand-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-cyan-500/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-700/60 border border-brand-500/30 text-brand-200 text-xs font-semibold backdrop-blur">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Hệ Thống Trực Tuyến 24/7 - Không Chờ Đợi
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
                Cổng Hành Chính & <br class="hidden sm:inline" />
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-200 via-cyan-200 to-white">Dịch Vụ Một Cửa Sinh Viên</span>
            </h1>

            <p class="text-lg text-slate-300 leading-relaxed">
                Giải quyết trực tuyến nhanh chóng các thủ tục: Giấy xác nhận sinh viên, bảng điểm, hoãn nghĩa vụ quân sự, cấp lại thẻ SV, bảo lưu kết quả và chế độ chính sách.
            </p>

            <!-- Quick Action Box / Search Tracking -->
            <div class="pt-4 max-w-xl mx-auto">
                <form asp-controller="Home" asp-action="Lookup" method="get" class="flex flex-col sm:flex-row gap-2 bg-white/10 p-2 rounded-2xl backdrop-blur-md border border-white/20 shadow-2xl">
                    <div class="relative flex-1">
                        <i data-lucide="search" class="w-5 h-5 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" name="requestCode" placeholder="Nhập mã hồ sơ (VD: YC-2026-0001)..." class="w-full pl-11 pr-4 py-3 rounded-xl bg-white text-slate-900 placeholder:text-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 border-0" required />
                    </div>
                    <button type="submit" class="px-6 py-3 rounded-xl bg-brand-500 hover:bg-brand-600 text-white font-semibold text-sm transition shadow-lg shadow-brand-500/40 flex items-center justify-center gap-2">
                        <span>Tra cứu ngay</span>
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </button>
                </form>
                <div class="text-xs text-slate-400 mt-2">
                    Gợi ý mã hồ sơ thử nghiệm: <a href="/Home/Lookup?requestCode=YC-2026-0001" class="text-brand-300 hover:underline">YC-2026-0001</a>, <a href="/Home/Lookup?requestCode=YC-2026-0002" class="text-brand-300 hover:underline">YC-2026-0002</a>
                </div>
            </div>
        </div>

        <!-- Metric Badges -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 max-w-4xl mx-auto">
            <div class="bg-white/5 border border-white/10 rounded-2xl p-4 text-center backdrop-blur">
                <div class="text-2xl sm:text-3xl font-extrabold text-white">@ViewBag.TotalStudents+</div>
                <div class="text-xs text-slate-400 mt-1">Sinh viên tham gia</div>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-4 text-center backdrop-blur">
                <div class="text-2xl sm:text-3xl font-extrabold text-cyan-300">@ViewBag.TotalProcedures</div>
                <div class="text-xs text-slate-400 mt-1">Thủ tục hành chính</div>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-4 text-center backdrop-blur">
                <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400">@ViewBag.TotalCompleted</div>
                <div class="text-xs text-slate-400 mt-1">Hồ sơ đã phê duyệt</div>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-4 text-center backdrop-blur">
                <div class="text-2xl sm:text-3xl font-extrabold text-amber-300">1-3 ngày</div>
                <div class="text-xs text-slate-400 mt-1">Thời gian xử lý chuẩn</div>
            </div>
        </div>
    </div>
</div>

<!-- Procedures Section -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10">
    <div class="bg-white rounded-2xl shadow-xl shadow-slate-200/60 border border-slate-200 p-6 sm:p-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-6 border-b border-slate-100 gap-4">
            <div>
                <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Danh Mục Thủ Tục Hành Chính Tiếp Nhận Trực Tuyến</h2>
                <p class="text-sm text-slate-500 mt-1">Sinh viên đăng nhập tài khoản trường để gửi hồ sơ và đính kèm giấy tờ</p>
            </div>
            @if (User.IsInRole("Student"))
            {
                <a asp-controller="Student" asp-action="Procedures" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-50 text-brand-700 hover:bg-brand-100 text-sm font-semibold transition">
                    <span>Xem tất cả thủ tục</span>
                    <i data-lucide="chevron-right" class="w-4 h-4"></i>
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold transition shadow-sm">
                    <i data-lucide="log-in" class="w-4 h-4"></i>
                    <span>Đăng nhập để gửi hồ sơ</span>
                </a>
            }
        </div>

        <!-- Procedures Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
            @foreach (var proc in Model)
            {
                <div class="group bg-slate-50/70 hover:bg-white border border-slate-200/80 hover:border-brand-300 rounded-2xl p-6 transition-all duration-200 hover:shadow-lg hover:-translate-y-1 flex flex-col justify-between">
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <div class="w-12 h-12 rounded-xl bg-brand-100 text-brand-600 flex items-center justify-center font-bold group-hover:scale-110 transition-transform">
                                <i data-lucide="file-text" class="w-6 h-6"></i>
                            </div>
                            <span class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">
                                <i data-lucide="clock" class="w-3.5 h-3.5"></i>
                                @proc.ProcessingDays ngày
                            </span>
                        </div>

                        <div>
                            <span class="text-xs font-mono font-bold text-brand-600">@proc.Code</span>
                            <h3 class="text-base font-bold text-slate-900 group-hover:text-brand-600 transition leading-snug mt-1">@proc.Name</h3>
                            <p class="text-xs text-slate-500 mt-2 line-clamp-3 leading-relaxed">@proc.Description</p>
                        </div>
                    </div>

                    <div class="pt-5 mt-4 border-t border-slate-200/60">
                        @if (User.IsInRole("Student"))
                        {
                            <a asp-controller="Student" asp-action="CreateRequest" asp-route-procedureId="@proc.Id" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-brand-300 hover:bg-brand-600 hover:text-white text-brand-700 text-xs font-bold transition shadow-xs">
                                <span>Gửi hồ sơ thủ tục này</span>
                                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-slate-200 hover:border-brand-400 hover:text-brand-600 text-slate-600 text-xs font-semibold transition">
                                <span>Đăng nhập để nộp đơn</span>
                                <i data-lucide="log-in" class="w-3.5 h-3.5"></i>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Process Workflow Section -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
    <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Quy Trình 4 Bước Dành Cho Sinh Viên</h2>
        <p class="text-sm text-slate-500 mt-2">Đơn giản hóa toàn bộ thủ tục hành chính, giải quyết mọi lúc mọi nơi</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 text-center space-y-3 relative">
            <div class="w-12 h-12 rounded-xl bg-blue-100 text-brand-600 flex items-center justify-center mx-auto text-lg font-bold">1</div>
            <h4 class="font-bold text-slate-900">Đăng Nhập Portal</h4>
            <p class="text-xs text-slate-500 leading-relaxed">Sử dụng tài khoản MSSV và mật khẩu trường cấp để vào hệ thống dịch vụ.</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-6 text-center space-y-3 relative">
            <div class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center mx-auto text-lg font-bold">2</div>
            <h4 class="font-bold text-slate-900">Chọn Thủ Tục & Đính Kèm</h4>
            <p class="text-xs text-slate-500 leading-relaxed">Điền lý do, số lượng bản in và tải ảnh chụp giấy tờ minh chứng cần thiết.</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-6 text-center space-y-3 relative">
            <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center mx-auto text-lg font-bold">3</div>
            <h4 class="font-bold text-slate-900">Theo Dõi Xử Lý</h4>
            <p class="text-xs text-slate-500 leading-relaxed">Xem cán bộ tiếp nhận, phản hồi lý do hoặc nộp bổ sung giấy tờ nếu được yêu cầu.</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-6 text-center space-y-3 relative">
            <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto text-lg font-bold">4</div>
            <h4 class="font-bold text-slate-900">Nhận Kết Quả</h4>
            <p class="text-xs text-slate-500 leading-relaxed">Tải giấy xác nhận điện tử có mã QR xác thực hoặc nhận bản cứng tại phòng Một Cửa.</p>
        </div>
    </div>
</div>
