@model StudentAdminPortal.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}

<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <!-- Logo & Header -->
        <div class="text-center space-y-2">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-brand-700 to-brand-500 text-white flex items-center justify-center mx-auto shadow-lg shadow-brand-500/30">
                <i data-lucide="graduation-cap" class="w-8 h-8"></i>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Đăng Nhập Cổng Một Cửa</h2>
            <p class="text-xs text-slate-500">Phòng Công Tác Sinh Viên - Quản Lý Hành Chính Điện Tử</p>
        </div>

        <!-- Demo Accounts Quick Fill Pill Box -->
        <div class="bg-gradient-to-r from-brand-50 to-indigo-50 border border-brand-200/80 rounded-2xl p-4 shadow-xs">
            <div class="flex items-center gap-2 text-xs font-bold text-brand-800 mb-2.5">
                <i data-lucide="sparkles" class="w-4 h-4 text-brand-600"></i>
                <span>Tài khoản mẫu để thử nghiệm nhanh (1-Click Fill):</span>
            </div>
            <div class="grid grid-cols-2 gap-2 text-xs">
                <button type="button" onclick="fillAccount('admin', 'admin123')" class="flex flex-col text-left p-2.5 rounded-xl bg-white border border-brand-200 hover:border-brand-500 hover:shadow-xs transition group">
                    <span class="font-bold text-amber-700 flex items-center gap-1">
                        <i data-lucide="shield" class="w-3.5 h-3.5"></i> Admin CTSV
                    </span>
                    <span class="text-[11px] text-slate-500 font-mono mt-0.5">admin / admin123</span>
                </button>

                <button type="button" onclick="fillAccount('SV2026001', 'student123')" class="flex flex-col text-left p-2.5 rounded-xl bg-white border border-brand-200 hover:border-brand-500 hover:shadow-xs transition group">
                    <span class="font-bold text-brand-700 flex items-center gap-1">
                        <i data-lucide="user-check" class="w-3.5 h-3.5"></i> SV Nguyễn Văn An
                    </span>
                    <span class="text-[11px] text-slate-500 font-mono mt-0.5">SV2026001 / student123</span>
                </button>

                <button type="button" onclick="fillAccount('SV2026002', 'student123')" class="flex flex-col text-left p-2.5 rounded-xl bg-white border border-brand-200 hover:border-brand-500 hover:shadow-xs transition group">
                    <span class="font-bold text-brand-700 flex items-center gap-1">
                        <i data-lucide="user-check" class="w-3.5 h-3.5"></i> SV Trần Thị Bích
                    </span>
                    <span class="text-[11px] text-slate-500 font-mono mt-0.5">SV2026002 / student123</span>
                </button>

                <button type="button" onclick="fillAccount('SV2026003', 'student123')" class="flex flex-col text-left p-2.5 rounded-xl bg-white border border-brand-200 hover:border-brand-500 hover:shadow-xs transition group">
                    <span class="font-bold text-brand-700 flex items-center gap-1">
                        <i data-lucide="user-check" class="w-3.5 h-3.5"></i> SV Lê Hoàng Nam
                    </span>
                    <span class="text-[11px] text-slate-500 font-mono mt-0.5">SV2026003 / student123</span>
                </button>
            </div>
        </div>

        <!-- Main Form Card -->
        <div class="bg-white rounded-2xl border border-slate-200 shadow-xl shadow-slate-200/50 p-6 sm:p-8 space-y-6">
            <form asp-controller="Account" asp-action="Login" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-center gap-2">
                        <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
                        <div asp-validation-summary="ModelOnly" class="font-medium"></div>
                    </div>
                }

                <div>
                    <label asp-for="Username" class="block text-xs font-bold text-slate-700 mb-1">Mã số sinh viên / Tên đăng nhập</label>
                    <div class="relative">
                        <i data-lucide="user" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input asp-for="Username" id="loginUsername" placeholder="Nhập MSSV (hoặc admin)" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" required />
                    </div>
                    <span asp-validation-for="Username" class="text-[11px] text-rose-600 mt-1 block"></span>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label asp-for="Password" class="block text-xs font-bold text-slate-700">Mật khẩu</label>
                        <span class="text-[11px] text-slate-400">Mặc định: student123</span>
                    </div>
                    <div class="relative">
                        <i data-lucide="lock" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input asp-for="Password" id="loginPassword" type="password" placeholder="••••••••" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" required />
                    </div>
                    <span asp-validation-for="Password" class="text-[11px] text-rose-600 mt-1 block"></span>
                </div>

                <div class="flex items-center justify-between">
                    <label class="flex items-center gap-2 text-xs text-slate-600 cursor-pointer">
                        <input asp-for="RememberMe" type="checkbox" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                    <a asp-controller="Home" asp-action="Lookup" class="text-xs font-semibold text-brand-600 hover:text-brand-700">Tra cứu hồ sơ</a>
                </div>

                <button type="submit" class="w-full py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm transition shadow-lg shadow-brand-500/30 flex items-center justify-center gap-2">
                    <i data-lucide="log-in" class="w-4 h-4"></i>
                    <span>Đăng nhập ngay</span>
                </button>
            </form>
        </div>

        <div class="text-center text-xs text-slate-400">
            Cần hỗ trợ tài khoản? Liên hệ Phòng CTSV (P.102 Nhà A1) hoặc hotline: 0243.869.2222
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillAccount(username, password) {
            document.getElementById('loginUsername').value = username;
            document.getElementById('loginPassword').value = password;
        }
    </script>
}
