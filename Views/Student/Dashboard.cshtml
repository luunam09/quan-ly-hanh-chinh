@model StudentAdminPortal.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển sinh viên";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Student Welcome Banner -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-brand-900 via-brand-800 to-indigo-900 text-white p-6 sm:p-8 shadow-xl">
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="space-y-2">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur border border-white/20 text-brand-200 text-xs font-semibold">
                    <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                    Cổng Dịch Vụ Sinh Viên
                </div>
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Xin chào, @Model.Student.FullName!</h1>
                <p class="text-xs sm:text-sm text-slate-300">
                    MSSV: <strong class="text-white font-mono">@Model.Student.Username</strong> &bull; Lớp: <span class="text-white font-semibold">@Model.Student.ClassName</span> &bull; Khoa: <span class="text-white font-semibold">@Model.Student.Faculty</span>
                </p>
            </div>

            <div class="flex items-center gap-3">
                <a asp-controller="Student" asp-action="Procedures" class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-brand-500 hover:bg-brand-400 text-white font-bold text-sm shadow-lg shadow-brand-500/40 transition">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                    <span>Nộp hồ sơ mới</span>
                </a>
                <a asp-controller="Account" asp-action="Profile" class="inline-flex items-center gap-2 px-4 py-3 rounded-2xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm backdrop-blur transition border border-white/20">
                    <i data-lucide="user-cog" class="w-4 h-4"></i>
                    <span class="hidden sm:inline">Hồ sơ cá nhân</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Alert for NeedUpdate requests -->
    @if (Model.NeedUpdateRequests > 0)
    {
        <div class="p-4 sm:p-5 rounded-2xl bg-rose-50 border-2 border-rose-300 text-rose-900 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-sm animate-pulse">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-rose-600 text-white flex items-center justify-center shrink-0">
                    <i data-lucide="alert-triangle" class="w-6 h-6"></i>
                </div>
                <div>
                    <h4 class="text-sm font-bold text-rose-900">Chú ý: Bạn có @Model.NeedUpdateRequests hồ sơ cần bổ sung giấy tờ gấp!</h4>
                    <p class="text-xs text-rose-700">Cán bộ phòng Một Cửa đã gửi yêu cầu bổ sung minh chứng. Vui lòng kiểm tra và tải file lên để tiếp tục xử lý.</p>
                </div>
            </div>
            <a asp-controller="Student" asp-action="MyRequests" asp-route-status="@RequestStatus.NeedUpdate" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shrink-0 shadow-sm transition">
                Xem hồ sơ cần bổ sung &rarr;
            </a>
        </div>
    }

    <!-- Stat Metric Cards -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        <a asp-controller="Student" asp-action="MyRequests" class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-brand-400 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-slate-500 uppercase">Tổng hồ sơ</span>
                <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center">
                    <i data-lucide="folder" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="text-2xl font-extrabold text-slate-900 mt-2">@Model.TotalRequests</div>
            <div class="text-[11px] text-slate-400 mt-1">Đã gửi từ trước tới nay</div>
        </a>

        <a asp-controller="Student" asp-action="MyRequests" asp-route-status="@RequestStatus.Pending" class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-amber-400 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-amber-700 uppercase">Chờ tiếp nhận</span>
                <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
                    <i data-lucide="clock" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="text-2xl font-extrabold text-amber-600 mt-2">@Model.PendingRequests</div>
            <div class="text-[11px] text-slate-400 mt-1">Đang xếp hàng duyệt</div>
        </a>

        <a asp-controller="Student" asp-action="MyRequests" asp-route-status="@RequestStatus.Processing" class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-blue-400 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-blue-700 uppercase">Đang xử lý</span>
                <div class="w-8 h-8 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
                    <i data-lucide="loader" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="text-2xl font-extrabold text-blue-600 mt-2">@Model.ProcessingRequests</div>
            <div class="text-[11px] text-slate-400 mt-1">Cán bộ đang thẩm định</div>
        </a>

        <a asp-controller="Student" asp-action="MyRequests" asp-route-status="@RequestStatus.NeedUpdate" class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-rose-400 hover:shadow-md transition @(Model.NeedUpdateRequests > 0 ? "ring-2 ring-rose-500 bg-rose-50/30" : "")">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-rose-700 uppercase">Cần bổ sung</span>
                <div class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center">
                    <i data-lucide="alert-circle" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="text-2xl font-extrabold text-rose-600 mt-2">@Model.NeedUpdateRequests</div>
            <div class="text-[11px] text-slate-400 mt-1">Cần SV đính kèm thêm</div>
        </a>

        <a asp-controller="Student" asp-action="MyRequests" asp-route-status="@RequestStatus.Approved" class="bg-white border border-slate-200 rounded-2xl p-5 hover:border-emerald-400 hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-emerald-700 uppercase">Đã hoàn thành</span>
                <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <i data-lucide="check-circle" class="w-4 h-4"></i>
                </div>
            </div>
            <div class="text-2xl font-extrabold text-emerald-600 mt-2">@Model.ApprovedRequests</div>
            <div class="text-[11px] text-slate-400 mt-1">Đã có kết quả / QR</div>
        </a>
    </div>

    <!-- Main Grid: Recent Requests & Procedures -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Recent Requests (Left 2 cols) -->
        <div class="lg:col-span-2 space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                    <i data-lucide="history" class="w-5 h-5 text-brand-600"></i>
                    Yêu Cầu Gửi Gần Đây
                </h3>
                <a asp-controller="Student" asp-action="MyRequests" class="text-xs font-bold text-brand-600 hover:text-brand-700 flex items-center gap-1">
                    Xem tất cả (@Model.TotalRequests) &rarr;
                </a>
            </div>

            @if (Model.RecentRequests.Count > 0)
            {
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm divide-y divide-slate-100 overflow-hidden">
                    @foreach (var req in Model.RecentRequests)
                    {
                        <div class="p-4 sm:p-5 hover:bg-slate-50 transition flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                            <div class="space-y-1.5 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-xs font-bold text-brand-700">@req.RequestCode</span>
                                    <span class="@RequestStatus.ToBadgeClass(req.Status) px-2.5 py-0.5 rounded-full text-[11px] font-bold">
                                        @RequestStatus.ToVietnamese(req.Status)
                                    </span>
                                </div>
                                <h4 class="text-sm font-bold text-slate-900">@req.Procedure?.Name</h4>
                                <div class="text-xs text-slate-400 flex items-center gap-3">
                                    <span>Nộp lúc: @req.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    <span>&bull;</span>
                                    <span>Hạn dự kiến: @(req.ExpectedDate?.ToString("dd/MM/yyyy") ?? "--")</span>
                                </div>
                            </div>

                            <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto justify-end">
                                @if (req.Status == RequestStatus.Approved)
                                {
                                    <a asp-controller="Student" asp-action="ViewCertificate" asp-route-id="@req.Id" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-700 hover:bg-emerald-100 text-xs font-bold border border-emerald-200 transition">
                                        <i data-lucide="printer" class="w-3.5 h-3.5"></i>
                                        <span>Giấy xác nhận</span>
                                    </a>
                                }
                                <a asp-controller="Student" asp-action="Details" asp-route-id="@req.Id" class="inline-flex items-center gap-1 px-3.5 py-1.5 rounded-xl bg-white border border-slate-200 hover:border-brand-500 text-slate-700 hover:text-brand-600 text-xs font-semibold transition">
                                    <span>Chi tiết</span>
                                    <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center space-y-3">
                    <div class="w-12 h-12 rounded-xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto">
                        <i data-lucide="file-x" class="w-6 h-6"></i>
                    </div>
                    <p class="text-xs text-slate-500">Bạn chưa gửi yêu cầu hành chính nào.</p>
                    <a asp-controller="Student" asp-action="Procedures" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-600 text-white text-xs font-bold hover:bg-brand-700 transition">
                        Nộp hồ sơ ngay
                    </a>
                </div>
            }
        </div>

        <!-- Quick Procedure Shortcuts (Right 1 col) -->
        <div class="space-y-4">
            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                <i data-lucide="zap" class="w-5 h-5 text-amber-500"></i>
                Thủ Tục Phổ Biến
            </h3>

            <div class="bg-white rounded-2xl border border-slate-200 p-4 space-y-3 shadow-sm">
                @foreach (var proc in Model.AvailableProcedures.Take(5))
                {
                    <a asp-controller="Student" asp-action="CreateRequest" asp-route-procedureId="@proc.Id" class="flex items-center justify-between p-3 rounded-xl hover:bg-brand-50/70 border border-transparent hover:border-brand-200 transition group">
                        <div class="space-y-0.5">
                            <span class="text-[10px] font-mono font-bold text-brand-600">@proc.Code</span>
                            <h5 class="text-xs font-bold text-slate-800 group-hover:text-brand-600 transition line-clamp-1">@proc.Name</h5>
                            <span class="text-[11px] text-slate-400">Xử lý trong @proc.ProcessingDays ngày</span>
                        </div>
                        <i data-lucide="arrow-right" class="w-4 h-4 text-slate-300 group-hover:text-brand-600 group-hover:translate-x-1 transition-all shrink-0"></i>
                    </a>
                }
                <div class="pt-2 border-t border-slate-100 text-center">
                    <a asp-controller="Student" asp-action="Procedures" class="text-xs font-bold text-brand-600 hover:text-brand-700">
                        Xem danh mục đầy đủ &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
