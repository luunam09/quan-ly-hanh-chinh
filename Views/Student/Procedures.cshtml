@model List<StudentAdminPortal.Models.Procedure>
@{
    ViewData["Title"] = "Danh mục thủ tục hành chính";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
        <div>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Danh Mục Thủ Tục Hành Chính</h1>
            <p class="text-xs text-slate-500 mt-1">Chọn thủ tục cần yêu cầu, đọc kỹ hướng dẫn giấy tờ và tiến hành nộp hồ sơ trực tuyến</p>
        </div>
        <a asp-controller="Student" asp-action="MyRequests" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white border border-slate-200 hover:border-brand-500 text-slate-700 hover:text-brand-600 text-xs font-bold transition shadow-xs">
            <i data-lucide="list-checks" class="w-4 h-4"></i>
            <span>Hồ sơ đã nộp của tôi</span>
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var proc in Model)
        {
            <div class="bg-white rounded-2xl border border-slate-200 hover:border-brand-400 p-6 flex flex-col justify-between shadow-xs hover:shadow-lg transition-all duration-200 group">
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="w-12 h-12 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center group-hover:scale-105 transition-transform">
                            <i data-lucide="file-text" class="w-6 h-6"></i>
                        </div>
                        <span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700">
                            <i data-lucide="clock" class="w-3.5 h-3.5 text-slate-400"></i>
                            @proc.ProcessingDays ngày làm việc
                        </span>
                    </div>

                    <div>
                        <div class="font-mono text-xs font-extrabold text-brand-600">@proc.Code</div>
                        <h3 class="text-base font-bold text-slate-900 mt-1 leading-snug group-hover:text-brand-600 transition">@proc.Name</h3>
                        <p class="text-xs text-slate-500 mt-2 leading-relaxed">@proc.Description</p>
                    </div>

                    @if (!string.IsNullOrEmpty(proc.RequiredDocuments))
                    {
                        <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 text-[11px] text-slate-600 space-y-1">
                            <div class="font-bold text-slate-700 flex items-center gap-1">
                                <i data-lucide="paperclip" class="w-3.5 h-3.5 text-brand-600"></i>
                                Giấy tờ cần chuẩn bị:
                            </div>
                            <div class="whitespace-pre-line text-slate-500 pl-4">@proc.RequiredDocuments</div>
                        </div>
                    }
                </div>

                <div class="pt-5 mt-4 border-t border-slate-100">
                    <a asp-controller="Student" asp-action="CreateRequest" asp-route-procedureId="@proc.Id" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold transition shadow-sm">
                        <i data-lucide="send" class="w-4 h-4"></i>
                        <span>Nộp hồ sơ ngay</span>
                    </a>
                </div>
            </div>
        }
    </div>
</div>
