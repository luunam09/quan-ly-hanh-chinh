@model List<StudentAdminPortal.Models.AdministrativeRequest>
@{
    ViewData["Title"] = "Hồ sơ của tôi";
    string? selectedStatus = ViewBag.SelectedStatus as string;
    string? searchTerm = ViewBag.SearchTerm as string;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-200">
        <div>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Hồ Sơ Hành Chính Của Tôi</h1>
            <p class="text-xs text-slate-500 mt-1">Theo dõi tiến độ xử lý và nhận kết quả văn bản hành chính đã gửi</p>
        </div>
        <a asp-controller="Student" asp-action="Procedures" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-bold transition shadow-sm">
            <i data-lucide="plus" class="w-4 h-4"></i>
            <span>Nộp hồ sơ mới</span>
        </a>
    </div>

    <!-- Filters & Search Bar -->
    <div class="bg-white rounded-2xl border border-slate-200 p-4 space-y-4 shadow-xs">
        <form asp-controller="Student" asp-action="MyRequests" method="get" class="flex flex-col sm:flex-row gap-3">
            <div class="relative flex-1">
                <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" name="search" value="@searchTerm" placeholder="Tìm theo mã hồ sơ (YC-...), tên thủ tục..." class="w-full pl-10 pr-4 py-2 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-brand-500" />
            </div>
            <input type="hidden" name="status" value="@selectedStatus" />
            <button type="submit" class="px-5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition flex items-center justify-center gap-1.5">
                <i data-lucide="filter" class="w-3.5 h-3.5"></i>
                <span>Tìm kiếm</span>
            </button>
            @if (!string.IsNullOrEmpty(selectedStatus) || !string.IsNullOrEmpty(searchTerm))
            {
                <a asp-controller="Student" asp-action="MyRequests" class="px-4 py-2 rounded-xl bg-slate-50 hover:bg-slate-100 text-slate-500 text-xs font-semibold transition flex items-center justify-center">
                    Đặt lại
                </a>
            }
        </form>

        <!-- Status Filter Pills -->
        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-slate-100 text-xs">
            <span class="text-slate-400 font-bold mr-1">Trạng thái:</span>
            <a asp-controller="Student" asp-action="MyRequests" asp-route-search="@searchTerm" class="px-3 py-1.5 rounded-xl font-bold transition @(string.IsNullOrEmpty(selectedStatus) ? "bg-brand-600 text-white shadow-xs" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                Tất cả (@Model.Count)
            </a>
            <a asp-controller="Student" asp-action="MyRequests" asp-route-status="@RequestStatus.Pending" asp-route-search="@searchTerm" class="px-3 py-1.5 rounded-xl font-bold transition @(selectedStatus == RequestStatus.Pending ? "bg-amber-500 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                Chờ tiếp nhận
            </a>
            <a asp-controller="Student" asp-action="MyRequests" asp-route-status="@RequestStatus.Processing" asp-route-search="@searchTerm" class="px-3 py-1.5 rounded-xl font-bold transition @(selectedStatus == RequestStatus.Processing ? "bg-blue-600 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                Đang xử lý
            </a>
            <a asp-controller="Student" asp-action="MyRequests" asp-route-status="@RequestStatus.NeedUpdate" asp-route-search="@searchTerm" class="px-3 py-1.5 rounded-xl font-bold transition @(selectedStatus == RequestStatus.NeedUpdate ? "bg-rose-600 text-white" : "bg-rose-50 text-rose-700 hover:bg-rose-100")">
                Cần bổ sung
            </a>
            <a asp-controller="Student" asp-action="MyRequests" asp-route-status="@RequestStatus.Approved" asp-route-search="@searchTerm" class="px-3 py-1.5 rounded-xl font-bold transition @(selectedStatus == RequestStatus.Approved ? "bg-emerald-600 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                Đã duyệt
            </a>
            <a asp-controller="Student" asp-action="MyRequests" asp-route-status="@RequestStatus.Rejected" asp-route-search="@searchTerm" class="px-3 py-1.5 rounded-xl font-bold transition @(selectedStatus == RequestStatus.Rejected ? "bg-slate-600 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                Từ chối
            </a>
        </div>
    </div>

    <!-- Requests Table -->
    @if (Model.Count > 0)
    {
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-600">
                    <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-bold uppercase tracking-wider text-[11px]">
                        <tr>
                            <th class="px-6 py-4">Mã hồ sơ</th>
                            <th class="px-6 py-4">Tên thủ tục hành chính</th>
                            <th class="px-6 py-4">Ngày nộp</th>
                            <th class="px-6 py-4">Hạn dự kiến</th>
                            <th class="px-6 py-4">Trạng thái</th>
                            <th class="px-6 py-4 text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="px-6 py-4 font-mono font-bold text-brand-700 whitespace-nowrap">
                                    <a asp-controller="Student" asp-action="Details" asp-route-id="@item.Id" class="hover:underline">
                                        @item.RequestCode
                                    </a>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="font-bold text-slate-900">@item.Procedure?.Name</div>
                                    <div class="text-[11px] text-slate-400 mt-0.5 line-clamp-1">@item.Purpose</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-slate-500">
                                    @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-slate-500">
                                    @(item.ExpectedDate?.ToString("dd/MM/yyyy") ?? "--")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="@RequestStatus.ToBadgeClass(item.Status) px-2.5 py-1 rounded-full text-[11px] font-bold">
                                        @RequestStatus.ToVietnamese(item.Status)
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap space-x-1.5">
                                    @if (item.Status == RequestStatus.Approved)
                                    {
                                        <a asp-controller="Student" asp-action="ViewCertificate" asp-route-id="@item.Id" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 hover:bg-emerald-100 font-bold border border-emerald-200 transition">
                                            <i data-lucide="printer" class="w-3.5 h-3.5"></i>
                                            <span>Xem kết quả</span>
                                        </a>
                                    }
                                    <a asp-controller="Student" asp-action="Details" asp-route-id="@item.Id" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold transition">
                                        <span>Chi tiết</span>
                                        <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center space-y-3">
            <div class="w-14 h-14 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto">
                <i data-lucide="inbox" class="w-8 h-8"></i>
            </div>
            <h3 class="text-sm font-bold text-slate-800">Không tìm thấy hồ sơ nào</h3>
            <p class="text-xs text-slate-500">Không có yêu cầu nào khớp với bộ lọc tìm kiếm hiện tại.</p>
        </div>
    }
</div>
