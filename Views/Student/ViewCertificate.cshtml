@model StudentAdminPortal.Models.AdministrativeRequest
@{
    ViewData["Title"] = $"Giấy xác nhận điện tử - {Model.RequestCode}";
    string? qrCodeBase64 = ViewBag.QrCodeBase64 as string;
    string? verifyUrl = ViewBag.VerifyUrl as string;
    var student = Model.Student;
}

<div class="max-w-4xl mx-auto px-4 py-8 space-y-6">
    <!-- Top Action Bar (hidden in print) -->
    <div class="flex items-center justify-between no-print bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
        <a asp-controller="Student" asp-action="Details" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-600 hover:text-brand-600">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Quay lại chi tiết hồ sơ
        </a>
        <div class="flex items-center gap-2">
            <button onclick="window.print()" class="px-5 py-2 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs transition shadow-sm flex items-center gap-1.5">
                <i data-lucide="printer" class="w-4 h-4"></i>
                <span>In hoặc Xuất PDF</span>
            </button>
        </div>
    </div>

    <!-- Official Certificate Paper Sheet (A4 styled) -->
    <div class="bg-white p-8 sm:p-14 rounded-2xl border border-slate-300 shadow-lg text-slate-900 font-serif leading-relaxed relative print:border-0 print:shadow-none print:p-0">
        <!-- Header: University & National Motto -->
        <div class="grid grid-cols-2 gap-4 pb-6 border-b-2 border-slate-900 text-center">
            <div>
                <div class="text-xs uppercase font-bold tracking-wide">BỘ GIÁO DỤC VÀ ĐÀO TẠO</div>
                <div class="text-xs uppercase font-extrabold tracking-wide mt-0.5">TRƯỜNG ĐẠI HỌC CÔNG NGHỆ</div>
                <div class="text-[11px] font-sans text-slate-600 mt-1">Phòng Công Tác Sinh Viên & Một Cửa</div>
                <div class="text-[11px] font-mono font-bold mt-1">Số: @Model.RequestCode / XNSV-CTSV</div>
            </div>

            <div>
                <div class="text-xs uppercase font-extrabold tracking-wide">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
                <div class="text-xs font-bold underline underline-offset-4 decoration-1 mt-0.5">Độc lập - Tự do - Hạnh phúc</div>
                <div class="text-[11px] font-sans text-slate-500 italic mt-2">
                    Hà Nội, ngày @(Model.CompletedAt?.Day ?? DateTime.UtcNow.Day) tháng @(Model.CompletedAt?.Month ?? DateTime.UtcNow.Month) năm @(Model.CompletedAt?.Year ?? DateTime.UtcNow.Year)
                </div>
            </div>
        </div>

        <!-- Document Title -->
        <div class="text-center my-8 space-y-2">
            <h1 class="text-2xl sm:text-3xl font-extrabold uppercase tracking-wider text-slate-950">
                @Model.Procedure?.Name.ToUpper()
            </h1>
            <div class="text-xs font-sans text-slate-500 italic">
                (Xác nhận thông tin học vụ và tình trạng đào tạo của sinh viên)
            </div>
        </div>

        <!-- Body Content -->
        <div class="space-y-4 text-sm font-sans leading-relaxed text-justify">
            <p class="font-bold">
                HIỆU TRƯỞNG TRƯỜNG ĐẠI HỌC CÔNG NGHỆ XÁC NHẬN:
            </p>

            <div class="space-y-2.5 pl-4">
                <div class="flex flex-col sm:flex-row sm:items-center">
                    <span class="w-48 text-slate-600 font-medium">Họ và tên sinh viên:</span>
                    <span class="font-bold text-base uppercase text-slate-900">@student?.FullName</span>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center">
                    <span class="w-48 text-slate-600 font-medium">Ngày sinh:</span>
                    <span class="font-semibold text-slate-900">@(student?.DateOfBirth?.ToString("dd/MM/yyyy") ?? "--")</span>
                    <span class="ml-6 mr-2 text-slate-600 font-medium">Giới tính:</span>
                    <span class="font-semibold text-slate-900">@(student?.Gender ?? "--")</span>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center">
                    <span class="w-48 text-slate-600 font-medium">Mã số sinh viên (MSSV):</span>
                    <span class="font-mono font-bold text-brand-800">@student?.Username</span>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center">
                    <span class="w-48 text-slate-600 font-medium">Số CCCD / CMND:</span>
                    <span class="font-mono font-semibold text-slate-900">@(student?.CccdNumber ?? "--")</span>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center">
                    <span class="w-48 text-slate-600 font-medium">Lớp sinh hoạt:</span>
                    <span class="font-semibold text-slate-900">@student?.ClassName</span>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center">
                    <span class="w-48 text-slate-600 font-medium">Khoa / Viện đào tạo:</span>
                    <span class="font-semibold text-slate-900">@student?.Faculty</span>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center">
                    <span class="w-48 text-slate-600 font-medium">Hình thức đào tạo:</span>
                    <span class="font-semibold text-slate-900">Chính quy tập trung</span>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center">
                    <span class="w-48 text-slate-600 font-medium">Tình trạng học tập:</span>
                    <span class="font-bold text-emerald-700">Đang theo học bình thường tại trường</span>
                </div>
                <div class="flex flex-col sm:flex-row items-start">
                    <span class="w-48 text-slate-600 font-medium shrink-0">Mục đích cấp giấy:</span>
                    <span class="font-medium text-slate-900 italic">@Model.Purpose</span>
                </div>
            </div>

            <p class="pt-4">
                Giấy xác nhận này có giá trị trong thời hạn <strong>06 tháng</strong> kể từ ngày ký. Các cơ quan, tổ chức có thể quét mã QR bên dưới để đối chiếu và xác thực tính hợp lệ của văn bản điện tử trực tiếp trên Cổng thông tin nhà trường.
            </p>
        </div>

        <!-- Footer Signatures & QR Verification -->
        <div class="grid grid-cols-2 gap-4 mt-12 pt-8 items-end">
            <!-- QR Code Section -->
            <div class="space-y-2">
                <div class="flex items-center gap-3">
                    @if (!string.IsNullOrEmpty(qrCodeBase64))
                    {
                        <img src="@qrCodeBase64" alt="Mã QR xác thực" class="w-24 h-24 p-1 border border-slate-300 rounded bg-white shadow-2xs" />
                    }
                    <div class="text-[11px] font-sans space-y-1">
                        <div class="font-bold text-slate-900">MÃ XÁC THỰC ĐIỆN TỬ:</div>
                        <div class="font-mono font-bold text-brand-700">@Model.VerificationCode</div>
                        <div class="text-slate-500 text-[10px]">Quét QR để kiểm tra tính hợp pháp của giấy xác nhận</div>
                    </div>
                </div>
            </div>

            <!-- Red Seal & Signature -->
            <div class="text-center font-sans relative">
                <div class="text-xs uppercase font-extrabold text-slate-900">TL. HIỆU TRƯỞNG</div>
                <div class="text-xs uppercase font-bold text-slate-700">TRƯỞNG PHÒNG CÔNG TÁC SINH VIÊN</div>

                <!-- Simulated Red Seal Stamp -->
                <div class="my-3 relative flex items-center justify-center">
                    <div class="w-28 h-28 rounded-full border-4 border-rose-600/80 text-rose-600 flex flex-col items-center justify-center p-2 text-center rotate-[-12deg] shadow-inner select-none pointer-events-none">
                        <div class="text-[7px] font-extrabold uppercase tracking-tighter">BỘ GIÁO DỤC VÀ ĐÀO TẠO</div>
                        <div class="text-[14px] font-extrabold leading-none my-0.5">★ ★ ★</div>
                        <div class="text-[8px] font-extrabold uppercase leading-tight">TRƯỜNG ĐẠI HỌC CÔNG NGHỆ</div>
                        <div class="text-[6px] font-bold text-rose-700">ĐÃ KÝ SỐ ĐIỆN TỬ</div>
                    </div>
                </div>

                <div class="font-serif italic text-base text-slate-900 font-bold">Nguyễn Văn Trưởng</div>
            </div>
        </div>
    </div>
</div>
