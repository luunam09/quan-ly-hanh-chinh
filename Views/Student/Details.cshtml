@model StudentAdminPortal.Models.AdministrativeRequest
@{
    ViewData["Title"] = $"Chi tiết hồ sơ {Model.RequestCode}";
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <!-- Breadcrumb & Top Bar -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-xs text-slate-500">
            <a asp-controller="Student" asp-action="Dashboard" class="hover:text-brand-600">Tổng quan</a>
            <span>&bull;</span>
            <a asp-controller="Student" asp-action="MyRequests" class="hover:text-brand-600">Hồ sơ của tôi</a>
            <span>&bull;</span>
            <span class="text-slate-900 font-bold font-mono">@Model.RequestCode</span>
        </div>

        <div class="flex items-center gap-2">
            @if (Model.Status == RequestStatus.Approved)
            {
                <a asp-controller="Student" asp-action="ViewCertificate" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition shadow-sm">
                    <i data-lucide="printer" class="w-4 h-4"></i>
                    <span>Xem & In giấy xác nhận</span>
                </a>
            }
            <a asp-controller="Student" asp-action="MyRequests" class="inline-flex items-center gap-1 px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition">
                <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                <span>Quay lại</span>
            </a>
        </div>
    </div>

    <!-- NeedUpdate Urgent Callout Box -->
    @if (Model.Status == RequestStatus.NeedUpdate)
    {
        <div class="bg-rose-50 border-2 border-rose-400 rounded-3xl p-6 text-rose-900 space-y-4 shadow-md">
            <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-rose-600 text-white flex items-center justify-center shrink-0">
                    <i data-lucide="alert-triangle" class="w-6 h-6"></i>
                </div>
                <div class="space-y-1">
                    <h3 class="text-base font-extrabold text-rose-900">Yêu cầu bổ sung hồ sơ / giấy tờ từ Quản trị viên</h3>
                    <p class="text-xs text-rose-700 leading-relaxed font-medium">@Model.AdminFeedback</p>
                </div>
            </div>

            <!-- Upload Supplement Form -->
            <form asp-controller="Student" asp-action="SubmitSupplement" method="post" enctype="multipart/form-data" class="bg-white rounded-2xl p-4 sm:p-5 border border-rose-200 space-y-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="RequestId" value="@Model.Id" />

                <div class="text-xs font-bold text-slate-800">Tải lên tệp bổ sung theo hướng dẫn trên:</div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <input type="file" name="Files" multiple class="text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-rose-50 file:text-rose-700 hover:file:bg-rose-100 cursor-pointer" required />
                    <input type="text" name="Note" placeholder="Ghi chú nội dung bổ sung cho cán bộ..." class="px-3 py-2 rounded-xl border border-slate-300 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500" />
                </div>

                <div class="flex justify-end pt-2">
                    <button type="submit" class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs transition shadow-sm flex items-center gap-1.5">
                        <i data-lucide="upload" class="w-3.5 h-3.5"></i>
                        <span>Nộp bổ sung ngay</span>
                    </button>
                </div>
            </form>
        </div>
    }

    <!-- Header Summary Card -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-xs space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-6 border-b border-slate-100 gap-4">
            <div class="space-y-1">
                <div class="flex items-center gap-2">
                    <span class="font-mono text-base font-extrabold text-brand-700">@Model.RequestCode</span>
                    <span class="@RequestStatus.ToBadgeClass(Model.Status) px-3 py-1 rounded-full text-xs font-bold">
                        @RequestStatus.ToVietnamese(Model.Status)
                    </span>
                </div>
                <h1 class="text-xl sm:text-2xl font-bold text-slate-900">@Model.Procedure?.Name</h1>
            </div>

            <div class="text-left sm:text-right text-xs text-slate-400 space-y-1">
                <div>Ngày nộp đơn: <strong class="text-slate-700">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
                <div>Hạn xử lý dự kiến: <strong class="text-brand-600">@(Model.ExpectedDate?.ToString("dd/MM/yyyy") ?? "--")</strong></div>
            </div>
        </div>

        <!-- Request Attributes Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                <span class="text-slate-400 block mb-1">Mục đích yêu cầu:</span>
                <span class="font-bold text-slate-800 leading-relaxed block">@Model.Purpose</span>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                <span class="text-slate-400 block mb-1">Số lượng bản cấp:</span>
                <span class="font-bold text-slate-800 block">@Model.Quantity bản</span>
                <span class="text-slate-400 block mt-2 mb-1">Hình thức nhận:</span>
                <span class="font-semibold text-slate-800 block">
                    @(Model.ReceiveMethod == "Digital" ? "Bản điện tử (Tải trực tuyến)" : "Nhận bản cứng tại phòng Một Cửa")
                </span>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                <span class="text-slate-400 block mb-1">Ghi chú của bạn:</span>
                <span class="text-slate-700 italic block">@(string.IsNullOrEmpty(Model.StudentNote) ? "(Không có ghi chú thêm)" : Model.StudentNote)</span>
            </div>
        </div>

        <!-- Feedback / Result Section -->
        @if (!string.IsNullOrEmpty(Model.AdminFeedback) || !string.IsNullOrEmpty(Model.ResultNote))
        {
            <div class="p-4 sm:p-5 rounded-2xl bg-blue-50/70 border border-blue-200 text-xs space-y-2">
                <div class="font-bold text-brand-900 flex items-center gap-1.5">
                    <i data-lucide="message-square" class="w-4 h-4 text-brand-600"></i>
                    Phản hồi & Hướng dẫn từ Cán bộ CTSV:
                </div>
                @if (!string.IsNullOrEmpty(Model.AdminFeedback))
                {
                    <p class="text-slate-700 leading-relaxed">@Model.AdminFeedback</p>
                }
                @if (!string.IsNullOrEmpty(Model.ResultNote))
                {
                    <div class="bg-white p-3 rounded-xl border border-blue-200 text-brand-900 font-medium">
                        <strong>Kết quả xử lý:</strong> @Model.ResultNote
                    </div>
                }
            </div>
        }
    </div>

    <!-- Attached Files Grid -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-xs space-y-4">
        <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
            <i data-lucide="paperclip" class="w-4 h-4 text-brand-600"></i>
            Tài Liệu & Hồ Sơ Đính Kèm (@Model.Attachments.Count)
        </h3>

        @if (Model.Attachments.Count > 0)
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                @foreach (var att in Model.Attachments)
                {
                    <div class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-50/50 hover:bg-slate-50 transition">
                        <div class="flex items-center gap-3 overflow-hidden">
                            <div class="w-9 h-9 rounded-lg bg-brand-100 text-brand-600 flex items-center justify-center shrink-0">
                                <i data-lucide="file" class="w-4 h-4"></i>
                            </div>
                            <div class="overflow-hidden">
                                <div class="text-xs font-bold text-slate-800 truncate" title="@att.FileName">@att.FileName</div>
                                <div class="text-[10px] text-slate-400 flex items-center gap-2 mt-0.5">
                                    <span>@((att.FileSize / 1024.0).ToString("N1")) KB</span>
                                    @if (att.IsSupplementary)
                                    {
                                        <span class="inline-flex px-1.5 py-0.2 rounded text-[9px] font-bold bg-amber-100 text-amber-800">Bổ sung</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <a href="@att.FilePath" target="_blank" download="@att.FileName" class="p-2 rounded-lg bg-white border border-slate-200 hover:border-brand-500 text-slate-600 hover:text-brand-600 text-xs font-bold shrink-0 shadow-2xs">
                            <i data-lucide="download" class="w-4 h-4"></i>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-xs text-slate-400 italic">Không có tệp đính kèm trong hồ sơ này.</p>
        }
    </div>

    <!-- Processing Logs / Stepper -->
    <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-8 shadow-xs space-y-4">
        <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
            <i data-lucide="git-commit" class="w-4 h-4 text-brand-600"></i>
            Nhật Ký Xử Lý Hồ Sơ
        </h3>

        <div class="relative pl-6 space-y-6 before:absolute before:left-2.5 before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-200">
            @foreach (var log in Model.Logs)
            {
                <div class="relative">
                    <div class="absolute -left-6 top-1 w-5 h-5 rounded-full bg-brand-500 text-white flex items-center justify-center ring-4 ring-white">
                        <i data-lucide="check" class="w-3 h-3"></i>
                    </div>
                    <div class="bg-slate-50 border border-slate-100 rounded-xl p-3.5 space-y-1">
                        <div class="flex items-center justify-between text-xs">
                            <span class="font-bold text-slate-900">@log.Action</span>
                            <span class="text-slate-400 text-[11px]">@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="text-xs text-slate-600">@log.Note</div>
                        <div class="text-[10px] text-slate-400">Thực hiện bởi: @log.ActorName (@log.ActorRole)</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
