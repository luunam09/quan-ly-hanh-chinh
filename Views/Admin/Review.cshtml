@model StudentAdminPortal.Models.AdministrativeRequest
@{
    ViewData["Title"] = $"Thẩm định hồ sơ {Model.RequestCode}";
    var student = Model.Student;
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <!-- Top Bar -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-xs text-slate-500">
            <a asp-controller="Admin" asp-action="Dashboard" class="hover:text-brand-600">Bảng điều khiển</a>
            <span>&bull;</span>
            <a asp-controller="Admin" asp-action="Requests" class="hover:text-brand-600">Quản lý hồ sơ</a>
            <span>&bull;</span>
            <span class="text-slate-900 font-bold font-mono">@Model.RequestCode</span>
        </div>

        <a asp-controller="Admin" asp-action="Requests" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition">
            <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
            <span>Quay lại danh sách</span>
        </a>
    </div>

    <!-- Main Grid: Info (Left 7 cols) & Review Action Panel (Right 5 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left Side: Applicant Info, Request Details, Attachments -->
        <div class="lg:col-span-7 space-y-6">
            <!-- Request Header Card -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-7 shadow-xs space-y-4">
                <div class="flex items-center justify-between">
                    <span class="font-mono text-base font-extrabold text-brand-700">@Model.RequestCode</span>
                    <span class="@RequestStatus.ToBadgeClass(Model.Status) px-3 py-1 rounded-full text-xs font-bold">
                        @RequestStatus.ToVietnamese(Model.Status)
                    </span>
                </div>

                <h1 class="text-xl font-extrabold text-slate-900 leading-snug">@Model.Procedure?.Name</h1>
                <div class="text-xs text-slate-400">
                    Thời gian gửi: @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") &bull; Hạn dự kiến: @(Model.ExpectedDate?.ToString("dd/MM/yyyy") ?? "--")
                </div>

                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100 text-xs space-y-2">
                    <div>
                        <span class="text-slate-400 block">Lý do / Mục đích yêu cầu:</span>
                        <span class="font-bold text-slate-800 leading-relaxed block mt-0.5">@Model.Purpose</span>
                    </div>
                    <div class="grid grid-cols-2 gap-4 pt-2 border-t border-slate-200/60">
                        <div>
                            <span class="text-slate-400 block">Số lượng:</span>
                            <span class="font-bold text-slate-800">@Model.Quantity bản</span>
                        </div>
                        <div>
                            <span class="text-slate-400 block">Hình thức nhận:</span>
                            <span class="font-semibold text-slate-800">
                                @(Model.ReceiveMethod == "Digital" ? "Bản điện tử trực tuyến" : "Nhận trực tiếp tại văn phòng")
                            </span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.StudentNote))
                    {
                        <div class="pt-2 border-t border-slate-200/60">
                            <span class="text-slate-400 block">Ghi chú của sinh viên:</span>
                            <span class="italic text-slate-700">@Model.StudentNote</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Student Profile Summary -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-7 shadow-xs space-y-4">
                <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                    <i data-lucide="user" class="w-4 h-4 text-brand-600"></i>
                    Thông Tin Lý Lịch Sinh Viên
                </h3>

                <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-xs">
                    <div>
                        <span class="text-slate-400 block mb-0.5">Họ và tên:</span>
                        <span class="font-bold text-slate-900 text-sm">@student?.FullName</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5">Mã số sinh viên:</span>
                        <span class="font-mono font-bold text-brand-700">@student?.Username</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5">Lớp sinh hoạt:</span>
                        <span class="font-semibold text-slate-800">@student?.ClassName</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5">Khoa / Viện:</span>
                        <span class="font-semibold text-slate-800">@student?.Faculty</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5">Số CCCD / CMND:</span>
                        <span class="font-mono text-slate-800">@(student?.CccdNumber ?? "--")</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5">Ngày sinh:</span>
                        <span class="text-slate-800">@(student?.DateOfBirth?.ToString("dd/MM/yyyy") ?? "--")</span>
                    </div>
                    <div>
                        <span class="text-slate-400 block mb-0.5">Số điện thoại:</span>
                        <span class="font-mono text-slate-800">@(student?.PhoneNumber ?? "--")</span>
                    </div>
                    <div class="sm:col-span-2">
                        <span class="text-slate-400 block mb-0.5">Email liên hệ:</span>
                        <span class="font-mono text-slate-800">@(student?.Email ?? "--")</span>
                    </div>
                </div>
            </div>

            <!-- Attached Files Preview & Download -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-7 shadow-xs space-y-4">
                <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                    <i data-lucide="paperclip" class="w-4 h-4 text-brand-600"></i>
                    Tài Liệu & Minh Chứng Đính Kèm (@Model.Attachments.Count)
                </h3>

                @if (Model.Attachments.Count > 0)
                {
                    <div class="space-y-2">
                        @foreach (var att in Model.Attachments)
                        {
                            <div class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-white transition">
                                <div class="flex items-center gap-3 overflow-hidden">
                                    <div class="w-8 h-8 rounded-lg bg-brand-100 text-brand-600 flex items-center justify-center shrink-0">
                                        <i data-lucide="file" class="w-4 h-4"></i>
                                    </div>
                                    <div class="overflow-hidden">
                                        <div class="text-xs font-bold text-slate-900 truncate">@att.FileName</div>
                                        <div class="text-[10px] text-slate-400">
                                            @((att.FileSize / 1024.0).ToString("N1")) KB &bull; Nộp lúc: @att.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                            @if (att.IsSupplementary)
                                            {
                                                <span class="ml-1 px-1.5 py-0.2 rounded bg-amber-100 text-amber-800 font-bold">Bổ sung</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <a href="@att.FilePath" target="_blank" download="@att.FileName" class="px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-brand-500 text-brand-600 font-bold text-xs flex items-center gap-1 shadow-2xs">
                                    <i data-lucide="download" class="w-3.5 h-3.5"></i>
                                    <span>Tải về</span>
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-xs text-slate-400 italic">Sinh viên không đính kèm tệp nào.</p>
                }
            </div>

            <!-- Logs / History -->
            <div class="bg-white rounded-3xl border border-slate-200 p-6 sm:p-7 shadow-xs space-y-4">
                <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                    <i data-lucide="history" class="w-4 h-4 text-brand-600"></i>
                    Lịch Sử Thao Tác Hồ Sơ
                </h3>

                <div class="relative pl-6 space-y-5 before:absolute before:left-2.5 before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-200 text-xs">
                    @foreach (var log in Model.Logs)
                    {
                        <div class="relative">
                            <div class="absolute -left-6 top-1 w-5 h-5 rounded-full bg-brand-500 text-white flex items-center justify-center ring-4 ring-white">
                                <i data-lucide="check" class="w-3 h-3"></i>
                            </div>
                            <div class="bg-slate-50 border border-slate-100 rounded-xl p-3">
                                <div class="flex items-center justify-between mb-1">
                                    <span class="font-bold text-slate-900">@log.Action</span>
                                    <span class="text-slate-400 text-[10px]">@log.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="text-slate-600">@log.Note</div>
                                <div class="text-[10px] text-slate-400 mt-1">Cán bộ: @log.ActorName</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Side: Evaluation & Action Form -->
        <div class="lg:col-span-5 space-y-6">
            <div class="sticky top-20 bg-white rounded-3xl border-2 border-brand-200 p-6 sm:p-7 shadow-lg shadow-brand-500/5 space-y-6">
                <div>
                    <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                        <i data-lucide="check-square" class="w-5 h-5 text-brand-600"></i>
                        Thẩm Định & Ra Quyết Định
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5">Cập nhật tiến độ hoặc phê duyệt / yêu cầu bổ sung hồ sơ</p>
                </div>

                <form asp-controller="Admin" asp-action="UpdateStatus" method="post" enctype="multipart/form-data" class="space-y-4 text-xs">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="RequestId" value="@Model.Id" />

                    <!-- Choose Next Status -->
                    <div>
                        <label class="block font-bold text-slate-800 mb-1.5">Trạng thái xử lý mới <span class="text-rose-500">*</span></label>
                        <select name="NewStatus" id="newStatusSelect" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-bold text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" onchange="onStatusChanged(this.value)" required>
                            <option value="@RequestStatus.Processing" selected="@(Model.Status == RequestStatus.Processing)">1. Đang xử lý (Tiếp nhận hồ sơ)</option>
                            <option value="@RequestStatus.NeedUpdate" selected="@(Model.Status == RequestStatus.NeedUpdate)">2. Yêu cầu bổ sung giấy tờ</option>
                            <option value="@RequestStatus.Approved" selected="@(Model.Status == RequestStatus.Approved)">3. Phê duyệt & Trả kết quả</option>
                            <option value="@RequestStatus.Rejected" selected="@(Model.Status == RequestStatus.Rejected)">4. Từ chối tiếp nhận</option>
                        </select>
                    </div>

                    <!-- Feedback / Reason -->
                    <div>
                        <label class="block font-bold text-slate-800 mb-1.5">
                            Ghi chú phản hồi / Lý do cho Sinh viên
                        </label>
                        <textarea name="AdminFeedback" id="adminFeedback" rows="3" placeholder="Nhập lý do từ chối, yêu cầu bổ sung giấy tờ gì, hoặc lời dặn sinh viên..." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">@Model.AdminFeedback</textarea>
                    </div>

                    <!-- Expected Date -->
                    <div>
                        <label class="block font-bold text-slate-800 mb-1.5">Hạn trả kết quả dự kiến</label>
                        <input type="date" name="ExpectedDate" value="@(Model.ExpectedDate?.ToString("yyyy-MM-dd"))" class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500" />
                    </div>

                    <!-- Result Note -->
                    <div>
                        <label class="block font-bold text-slate-800 mb-1.5">Thông tin kết quả (Lịch hẹn / Hướng dẫn)</label>
                        <input type="text" name="ResultNote" value="@Model.ResultNote" placeholder="VD: Mời SV đến P.102 Nhà A1 nhận bản cứng vào 8h30 thứ Hai..." class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500" />
                    </div>

                    <!-- Attach Result File (PDF, etc.) -->
                    <div>
                        <label class="block font-bold text-slate-800 mb-1.5">Đính kèm file kết quả (Nếu có)</label>
                        <input type="file" name="ResultFile" class="text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-brand-50 file:text-brand-700 hover:file:bg-brand-100 cursor-pointer" />
                        @if (!string.IsNullOrEmpty(Model.ResultFileUrl))
                        {
                            <div class="mt-1 text-[11px] text-emerald-600 font-bold">
                                &check; Đã có file kết quả tải lên trước đó.
                            </div>
                        }
                    </div>

                    <div class="pt-4 border-t border-slate-200">
                        <button type="submit" class="w-full py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs transition shadow-md shadow-brand-500/20 flex items-center justify-center gap-2">
                            <i data-lucide="check" class="w-4 h-4"></i>
                            <span>Xác nhận cập nhật hồ sơ</span>
                        </button>
                    </div>
                </form>

                @if (Model.Status == RequestStatus.Approved)
                {
                    <div class="pt-2 text-center border-t border-slate-100">
                        <a asp-controller="Student" asp-action="ViewCertificate" asp-route-id="@Model.Id" target="_blank" class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 hover:underline">
                            <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                            Xem trước Giấy xác nhận điện tử của SV
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function onStatusChanged(val) {
            const feedback = document.getElementById('adminFeedback');
            if (val === 'NeedUpdate' && !feedback.value) {
                feedback.placeholder = 'BẮT BUỘC: Nhập chi tiết giấy tờ sinh viên cần chụp lại hoặc bổ sung thêm...';
            } else if (val === 'Rejected' && !feedback.value) {
                feedback.placeholder = 'BẮT BUỘC: Nhập lý do từ chối tiếp nhận hồ sơ này...';
            }
        }
    </script>
}
